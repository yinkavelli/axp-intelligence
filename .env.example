# Copy this file to a new file named .env and put your keys there (NOT in this file).
# With no keys the app runs in DEMO mode (simulated council).
ANTHROPIC_API_KEY=

# Only if the Anthropic API says "key is not scoped to a workspace":
ANTHROPIC_WORKSPACE_ID=

# Only needed if you point any agent at OpenAI (or another OpenAI-compatible provider) in config/council.json:
OPENAI_API_KEY=

PORT=3000
