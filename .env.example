# Copy to .env and fill in. Without a key the app runs in DEMO mode (simulated council).
ANTHROPIC_API_KEY=
# Only if the API returns "key is not scoped to a workspace": the ID of the workspace to use
ANTHROPIC_WORKSPACE_ID=
AXP_MODEL=claude-sonnet-5-5
# Optional cost lever for the council agents: low | medium | high (leave blank for the model default)
AXP_EFFORT=
# Cheap model used only for the pre-flight check
AXP_FAST_MODEL=claude-haiku-4-5
PORT=3000
